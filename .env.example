# Public browser configuration. Every VITE_ value is visible to website visitors.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
VITE_SUPABASE_PROJECT_ID=your_project_id_here

# Server-side configuration. Never add a VITE_ prefix to these values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_PROJECT_ID=your_project_id_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_SECRET_KEY=your_secret_key_here
LOVABLE_CRON_SECRET=your_random_cron_secret_here
LOVABLE_CRON_SECRET_PREVIOUS=
LOGIN_RATE_LIMIT_PEPPER=your_random_32_character_or_longer_secret_here
OWNER_SETUP_CODE=your_one_time_setup_code_here
OWNER_SETUP_EMAIL=owner@example.com
PUBLIC_SITE_URL=https://your-site.example
VITE_PUBLIC_SITE_URL=https://your-site.example

# Optional, non-secret rate-limit settings.
LOGIN_LOCKOUT_MINUTES=15
MAX_LOGIN_ATTEMPTS=5
MAX_IP_LOGIN_ATTEMPTS=25
LOGIN_ATTEMPT_WINDOW_MINUTES=15
